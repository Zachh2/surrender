# Copy values into Vercel Project > Settings > Environment Variables.
# For local development only, copy this to .env and fill in the values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SERVER_KEY
# Choose your own unique teacher password (12+ characters). No default password.
TEACHER_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
